# ============================================
# AWS Infrastructure Environment Variables
# Project: Property Listing Application
# ============================================
#
# IMPORTANT: Copy this file to .env and fill in the actual values
# DO NOT commit .env file to git!
#
# After running setup.sh, find these values in infra/resources.txt
# ============================================

# ----------------------------------------
# AWS Configuration
# ----------------------------------------
AWS_REGION=ap-southeast-5
AWS_ACCESS_KEY_ID=<from resources.txt: IAM_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<from resources.txt: IAM_SECRET_KEY>

# S3 Bucket Names
AWS_S3_BUCKET_MEDIA=property-media
AWS_S3_BUCKET_STATIC=property-static
AWS_S3_BUCKET_BACKUPS=property-backups

# S3 URLs (auto-generated based on bucket names)
NEXT_PUBLIC_MEDIA_URL=https://property-media.s3.ap-southeast-5.amazonaws.com

# ----------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------
# RDS Endpoint from resources.txt
DB_HOST=<from resources.txt: RDS_ENDPOINT>
DB_PORT=5432
DB_NAME=property_production
DB_USERNAME=admin
DB_PASSWORD=<from resources.txt: RDS_PASSWORD>

# Connection string format for Prisma/TypeORM/etc
DATABASE_URL=postgresql://admin:<RDS_PASSWORD>@<RDS_ENDPOINT>:5432/property_production

# ----------------------------------------
# Next.js Application Configuration
# ----------------------------------------
NODE_ENV=production

# Base path (leave empty for root domain)
NEXT_PUBLIC_BASE_PATH=

# API URL (use your domain or EC2 IP)
NEXT_PUBLIC_API_URL=http://<ELASTIC_IP from resources.txt>
# After SSL setup: https://yourdomain.com

# Theme toggle feature
NEXT_PUBLIC_ENABLE_THEME_TOGGLE=true

# Listing wizard validation mode
NEXT_PUBLIC_LISTING_WIZARD_STRICT=true

# ----------------------------------------
# Server Configuration
# ----------------------------------------
# Port for Next.js server (default: 3000)
PORT=3000

# Number of PM2 instances (optional)
PM2_INSTANCES=2

# ----------------------------------------
# Security & Authentication
# ----------------------------------------
# JWT secret for authentication (generate a secure random string)
JWT_SECRET=<generate using: openssl rand -base64 32>

# Session secret (generate a secure random string)
SESSION_SECRET=<generate using: openssl rand -base64 32>

# CORS origins (comma-separated if multiple)
CORS_ORIGINS=http://<ELASTIC_IP>,https://yourdomain.com

# ----------------------------------------
# Email Configuration (Optional)
# ----------------------------------------
# SMTP settings for sending emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Property Listing App

# ----------------------------------------
# External Services (Optional)
# ----------------------------------------
# Google Maps API (for location features)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Analytics (Google Analytics, etc)
NEXT_PUBLIC_GA_TRACKING_ID=

# Error tracking (Sentry, etc)
SENTRY_DSN=

# ----------------------------------------
# File Upload Configuration
# ----------------------------------------
# Max file size for uploads (in bytes)
MAX_FILE_SIZE=10485760  # 10MB

# Allowed file types for property images
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Allowed video types
ALLOWED_VIDEO_TYPES=video/mp4,video/webm

# ----------------------------------------
# Feature Flags
# ----------------------------------------
ENABLE_VIRTUAL_TOURS=false
ENABLE_AI_DESCRIPTION=false
ENABLE_ANALYTICS_DASHBOARD=false

# ----------------------------------------
# Caching Configuration
# ----------------------------------------
# Redis (if using for caching/sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Cache TTL (in seconds)
CACHE_TTL=3600

# ----------------------------------------
# Backup Configuration
# ----------------------------------------
# S3 backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ----------------------------------------
# Monitoring & Logging
# ----------------------------------------
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# CloudWatch logs (optional)
CLOUDWATCH_LOG_GROUP=/aws/property-app
CLOUDWATCH_LOG_STREAM=application

# ----------------------------------------
# Development / Testing Only
# ----------------------------------------
# Mock data mode (disable in production)
ENABLE_MOCK_DATA=false

# Debug mode
DEBUG=false
